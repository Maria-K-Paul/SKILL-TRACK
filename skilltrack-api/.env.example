DATABASE_URL=postgresql+psycopg://skilltrack_user:YOUR_PASSWORD@localhost:5432/skilltrack
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=480

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

FRONTEND_URL=http://localhost:5173
# Public URL embedded in QR codes on certificates; usually the same as FRONTEND_URL
# On Render/Railway set to your public domain, e.g. https://skilltrack.onrender.com
PUBLIC_BASE_URL=http://localhost:5173

# CORS origins (comma-separated for production, local regex handles dev)
# Example for production: CORS_ORIGINS=https://skilltrack-web.onrender.com,https://www.skilltrack.com
CORS_ORIGINS=
