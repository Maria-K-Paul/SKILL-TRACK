# Neon connection string (Neon console > Connect). Required: the API will not start without it.
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_MINUTES=1440

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

FRONTEND_URL=http://localhost:5173
